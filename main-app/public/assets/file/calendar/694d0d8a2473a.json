		{
			"name": "Log In (Submit)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for successful login and extract token",
							"pm.test(\"Login response contains token\", function () {",
							"    var jsonData = {};",
							"    try {",
							"        jsonData = pm.response.json();",
							"    } catch (e) {",
							"        pm.expect.fail(\"Response is not valid JSON\");",
							"    }",
							"    if (jsonData && jsonData.token) {",
							"        pm.environment.set(\"token\", jsonData.token);",
							"        pm.expect(jsonData.token, \"Token should not be empty\").to.not.be.empty;",
							"    } else {",
							"        pm.environment.unset(\"token\");",
							"        console.warn(\"Token property is missing in the response.\");",
							"        pm.expect.fail(\"Token property is missing in the response.\");",
							"    }",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
